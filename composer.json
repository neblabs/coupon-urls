{
  "name": "project/restored-project",
  "description": "Reconstructed project configuration",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "nilportugues/sql-query-builder": "^1.8",
    "voku/stringy": "^6.5"
  },
  "require-dev": {
    "brain/monkey": "^2.6",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "filp/whoops": "^2.15",
    "illuminate/support": "^10.33",
    "league/climate": "^3.8",
    "mockery/mockery": "^1.6",
    "monolog/monolog": "^2.9",
    "pestphp/pest": "^2.2",
    "pestphp/pest-plugin-arch": "^2.1",
    "pestphp/pest-plugin-watch": "^2.0",
    "php-stubs/woocommerce-stubs": "^8.3",
    "php-stubs/wordpress-stubs": "^6.4",
    "phpstan/phpstan": "^1.10",
    "phpunit/phpunit": "^10.0.18",
    "rafark/phpunit-polyfills": "1.0.4",
    "rector/rector": "^0.18",
    "spatie/ignition": "^1.1",
    "symplify/easy-coding-standard": "^12.0",
    "wp-coding-standards/wpcs": "^3.0"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/rafark/phpunit-polyfills.git"
    }
  ],
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "pestphp/pest-plugin": true
    }
  }
}
